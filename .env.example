# Load these values explicitly in the shell; no credentials are bundled.
VTR_EVALUATOR_MODEL=/path/to/evaluator-checkpoint
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VTEXTBENCH_QWEN_CHAT_MODEL=qwen3.7-plus
VTEXTBENCH_QWEN_IMAGE_MODEL=qwen-image-3.0
VTEXTBENCH_H3_SERVICE_URL=http://127.0.0.1:18123
VTEXTBENCH_MODELS_ROOT=/absolute/path/to/models
# The workspace defaults to the current directory; bundled prompts are automatic.
VTR_BENCH_PROJECT_ROOT=
VTR_BENCH_RUNS_ROOT=
CUDA_VISIBLE_DEVICES=0,1,2,3
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_OMNI_VIDEO_SYNC_TIMEOUT=3600
